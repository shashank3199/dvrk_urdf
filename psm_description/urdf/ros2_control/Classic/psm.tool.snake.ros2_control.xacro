<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="psm_tool_snake_ros2_control" params="prefix">

        <joint name="${prefix}_outer_wrist_pitch1">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="${prefix}_outer_wrist_yaw1">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="${prefix}_outer_wrist_yaw2">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="${prefix}_outer_wrist_pitch2">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="${prefix}_jaw">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Mimic joints -->
        <joint name="${prefix}_jaw_mimic_1">
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="${prefix}_jaw_mimic_2">
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

    </xacro:macro>

</robot>
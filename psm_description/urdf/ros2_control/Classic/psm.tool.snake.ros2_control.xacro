<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ROS2 Control Macro for the PSM Tool Snake -->
    <xacro:macro name="psm_tool_snake_ros2_control" params="prefix">

        <!-- Command Joint 0 -->
        <joint name="${prefix}_outer_wrist_pitch1">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Command Joint 1 -->
        <joint name="${prefix}_outer_wrist_yaw1">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Command Joint 2 -->
        <joint name="${prefix}_outer_wrist_yaw2">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Command Joint 3 -->
        <joint name="${prefix}_outer_wrist_pitch2">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Command Joint 4 -->
        <joint name="${prefix}_jaw">
            <command_interface name="position" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Mimic Joint 0: Command Joint 4 -->
        <joint name="${prefix}_jaw_mimic_1">
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <!-- Mimic Joint 1: Command Joint 4 -->
        <joint name="${prefix}_jaw_mimic_2">
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

    </xacro:macro>

</robot>
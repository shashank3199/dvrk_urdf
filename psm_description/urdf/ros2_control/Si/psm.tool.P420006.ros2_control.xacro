<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="P420006_ros2_control" params="prefix">

        <ros2_control name="${prefix}_P420006_ros2_control" type="system">
            <hardware>
                <plugin>fake_components/GenericSystem</plugin>
            </hardware>

            <joint name="${prefix}_insertion">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}_roll">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}_wrist_pitch">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}_wrist_yaw">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}_jaw">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <!-- Mimic Joints -->
            <joint name="${prefix}_jaw_1">
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}_jaw_2">
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

        </ros2_control>

    </xacro:macro>

</robot>
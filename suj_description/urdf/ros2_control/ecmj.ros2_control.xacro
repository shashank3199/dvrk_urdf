<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="ecmj_ros2_control">

        <ros2_control name="ecmj_ros2_control" type="system">
            <hardware>
                <plugin>fake_components/GenericSystem</plugin>
            </hardware>

            <joint name="SUJ_ECM_J0">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="SUJ_ECM_J1">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="SUJ_ECM_J2">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="SUJ_ECM_J3">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

        </ros2_control>

    </xacro:macro>

</robot>
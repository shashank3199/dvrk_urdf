<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="davinci_core_ros2_control" params="arm_name">

        <ros2_control name="${arm_name}_davinci_core_ros2_control" type="system">
            <hardware>
                <plugin>fake_components/GenericSystem</plugin>
            </hardware>

            <joint name="${arm_name}_outer_yaw_joint">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${arm_name}_outer_pitch_base_joint">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${arm_name}_outer_pitch_front_joint">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${arm_name}_outer_pitch_bottom_joint">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${arm_name}_outer_pitch_top_joint">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${arm_name}_outer_insertion_joint">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${arm_name}_tool_insertion_joint">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

        </ros2_control>

    </xacro:macro>

</robot>